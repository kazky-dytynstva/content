{"manifest":{"schemaVersion":1,"id":"97d2cef233374c96c4913ca8d7a25c67","kind":"tale","revision":1,"createdAt":"2026-10-23T23:06:16.798Z","savedAt":"2026-10-23T23:08:16.498Z","targetId":84,"baseFingerprint":"d00afa329a881714e697127c219cb6f558bfe5ed01ed9b26c1ee18ebf7715eff","createdBy":"Quotadian"},"payload":{"name":"Мурашка","summary":"Мурашка, що прагнула кращого життя, подорожує світом, здивована красою і величчю кожного нового місця. Але, врешті-решт, її прагнення стають фатальними.","tags":["poem","audio","text","author"],"createDate":"1970-01-01T01:00:00.000","updateDate":null,"text":{"items":[{"kind":"image","text":null,"imageIndex":0},{"kind":"text","text":"Вилізла мурашка на лопух,","imageIndex":null},{"kind":"text","text":"Подивилась весело навкруг:","imageIndex":null},{"kind":"text","text":"— Скільки тут повітря і тепла,","imageIndex":null},{"kind":"text","text":"Я ж, дурненька, в бур’яні жила!","imageIndex":null},{"kind":"text","text":"Вилізла мурашка на ромен,","imageIndex":null},{"kind":"text","text":"Мовби крила виросли з рамен:","imageIndex":null},{"kind":"text","text":"— Що за диво — пелюстки в росі,","imageIndex":null},{"kind":"text","text":"Як могла я жить на лопусі!","imageIndex":null},{"kind":"text","text":"Вилізла мурашка на таріль","imageIndex":null},{"kind":"text","text":"Соняха, що сяяв серед піль:","imageIndex":null},{"kind":"text","text":"— Боже, скільки золота й зерна,","imageIndex":null},{"kind":"text","text":"Що ромен? Билиночка сумна!","imageIndex":null},{"kind":"text","text":"Вилізла мурашка на сосну,","imageIndex":null},{"kind":"text","text":"Глянула в далечину ясну:","imageIndex":null},{"kind":"text","text":"— Піді мною цілий світ лежить, —","imageIndex":null},{"kind":"text","text":"Як могла я на бадиллі жить!","imageIndex":null},{"kind":"text","text":"Над сосною чорна хмара йшла,","imageIndex":null},{"kind":"text","text":"Срібний дощик по землі тягла.","imageIndex":null},{"kind":"text","text":"А мурашка крикнула:— Зажди! —","imageIndex":null},{"kind":"text","text":"I взялась за ниточку води,","imageIndex":null},{"kind":"text","text":"Вилізла на хмару і лягла","imageIndex":null},{"kind":"text","text":"Біля сонця, горда, хоч мала.","imageIndex":null},{"kind":"text","text":"— Як могла я жити на сосні,","imageIndex":null},{"kind":"text","text":"Коли сонце впорівень мені!","imageIndex":null},{"kind":"text","text":"Розійшлася хмара дощова —","imageIndex":null},{"kind":"text","text":"Вниз летить мурашка ледь жива.","imageIndex":null},{"kind":"text","text":"Де вона — дарма питаєш ти,","imageIndex":null},{"kind":"text","text":"Вже її нікому не знайти!","imageIndex":null}],"minReadingTime":1,"maxReadingTime":2},"audio":{"fileSize":1033753,"duration":100878000,"files":{"original":{"path":"media/c72d0ce622f0cd8ab24b14c8c7f8585224d5ccda118575dff2a232545bb0b8c1.mp3","byteLength":4037805,"sha256":"c72d0ce622f0cd8ab24b14c8c7f8585224d5ccda118575dff2a232545bb0b8c1"},"thumbnail":{"path":"media/c4515b11dd688560eaa057c321f735d79ac083e8953672b40d97fc10981a7d35.m4a","byteLength":1033753,"sha256":"c4515b11dd688560eaa057c321f735d79ac083e8953672b40d97fc10981a7d35"}}},"crew":{"author":[{"kind":"ready","contentId":28,"draftId":null}],"reader":[{"kind":"ready","contentId":99,"draftId":null}]},"adminConfig":{"isHidden":null,"isReviewed":null,"comment":null},"images":[{"index":0,"files":{"original":{"path":"media/35699a0ab20a3fa13c716be80ea971ee7b3117e824525ec9110fc9a37e59c1bb.png","byteLength":288967,"sha256":"35699a0ab20a3fa13c716be80ea971ee7b3117e824525ec9110fc9a37e59c1bb"},"thumbnail":{"path":"media/675a7b837d9c1e2b72149fd72fd67a0e9ed9d060f14565f8c8a13341346031cf.jpg","byteLength":53461,"sha256":"675a7b837d9c1e2b72149fd72fd67a0e9ed9d060f14565f8c8a13341346031cf"}}}]}}