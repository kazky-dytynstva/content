{
  "id": 88,
  "name": "Ой, баю мій, баю",
  "create_date": "1970-01-01T01:00:00.000",
  "update_date": "2026-02-08T14:45:56.223236",
  "summary": "Мелодійна колискова, в якій мати співає своїй дитині, аби вона спокійно заснула і росла щасливою, не знаючи горя. Пісня сповнена ніжності та турботи.",
  "tags": [
    "audio",
    "lullaby",
    "text",
    "poem"
  ],
  "text": {
    "items": [
      "[0]",
      "Ой, баю мій, баю,",
      "Котка заспіваю,",
      "А-а,а-а,а!",
      "Щоб дитятко спало,",
      "Горенька не знало.",
      "А-а, а-а, а!",
      "Щоб дитятко спало,",
      "Щасливим зростало,",
      "А-а, а-а, а!",
      "Ой, баю, мій баю,",
      "Котка заспіваю,",
      "А-а, а-а, а!"
    ],
